# The project-local sandbox. Rebuilt with `sh 00_sandbox/setup.sh`, never shipped.
# Nothing here is committed on purpose: a gitignored build environment cannot go
# stale in a way anyone would notice, because it is never the thing that ships.
.venv/
node_modules/
00_sandbox/browsers/
00_sandbox/_smoke_test.*

# Python bytecode
__pycache__/
*.py[cod]

# Build artefacts. Every one of these is REGENERATED by a script in this repository, so
# committing them would mean two copies of the same bytes, one of which goes stale.
#   brand-kit/09_delivery/GRU953-Brand-Kit.zip   <- brand-kit/09_delivery/package.py
#   delivery/                                    <- package.py
brand-kit/09_delivery/*.zip
delivery/
*.tmp.svg
*.tmp.png
png.building/

# Staging and superseded work. `_to_delete/` exists because the desktop bridge can move a
# file but cannot delete one; nothing in it should ever reach a commit.
_to_delete/
_incoming/

# macOS
.DS_Store
